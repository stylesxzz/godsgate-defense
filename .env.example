# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
DB_PATH=./data/godsgate.sqlite
TRUST_PROXY=false

# Admin username and scrypt password hash. Generate with: npm run admin:hash
ADMIN_USERNAME=Stylesxz
ADMIN_PASSWORD_HASH=
# Use at least 32 random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Solana mainnet USDT billing: USD 50 per agent per calendar month
PAYMENT_WALLET=
HELIUS_API_KEY=
# Optional override. Otherwise the standard Helius mainnet RPC URL is used.
HELIUS_RPC_URL=
PAYMENT_AMOUNT_USDT=50